BOT_TOKEN=your_bot_token_here
OPENROUTER_API_KEY=your_openrouter_key_here
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LANE_MODEL=google/gemma-4-31b-it:free
# Модели для картинок: vision — ответы на фото, image_prompt — промпт картинки автопоста
VISION_MODEL=google/gemma-4-31b-it:free
IMAGE_PROMPT_MODEL=nvidia/nemotron-3.5-lightning:free
NEWS_CHANNEL_ID=your_channel_id_here
ADMIN_CHAT_ID=your_telegram_user_id_here
ADMIN_USER_IDS=123456789,987654321
# NFT-коллекции TON для автопостинга: Имя:адрес,Имя2:адрес2 (через запятую).
# Пусто — дефолтный watchlist (Lost Dogs). Требует MARKETAPP_API_KEY и/или TONAPI_API_KEY.
NFT_COLLECTIONS=
# ЛС-доступ: бот отвечает в личке только создателю (ID и/или @username)
CREATOR_USER_IDS=123456789
CREATOR_USERNAME=hinorum
PORT=10000
MARKETAPP_API_KEY=your_marketapp_api_key_here
MARKETAPP_WALLET=your_ton_wallet_address_here
TONCENTER_API_KEY=your_toncenter_api_key_here
TONAPI_API_KEY=your_tonapi_api_key_here

# Крипто-бухгалтерия (опционально, без них ручной ввод и CoinGecko)
# ИНН налогоплательщика — печатается в шапке отчёта 3-НДФЛ (можно пустым)
TAXPAYER_INN=
# Статус по умолчанию: resident | nonresident | miner
TAX_STATUS=resident
# Метод расчёта cost basis: fifo | wac (weighted average)
COST_BASIS_METHOD=fifo
# Telegram ID владельца учёта (если пусто — берётся из CREATOR_USER_IDS[0])
CRYPTO_OWNER_ID=
# Курс ЦБ РФ (https://www.cbr-xml-daily.ru) — без ключа, бесплатный
CBR_API_URL=https://www.cbr-xml-daily.ru
# CEX API (read-only ключи — безопасны для бота, не дают выводить средства)
# Bybit: Account → API Management → Create New Key, permissions: Read-Only
BYBIT_API_KEY=
BYBIT_API_SECRET=
# OKX: Trade → My API → Create API, permissions: Read
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# Etherscan V2 — один ключ на все EVM-сети (https://etherscan.io/apis).
# Нужен, чтобы бот сам вытягивал историю переводов по EVM-кошелькам.
# Без ключа TON-кошельки сканируются, EVM — нет.
ETHERSCAN_API_KEY=
# Сети EVM для сканирования, через запятую:
# 1 — Ethereum, 10 — Optimism, 56 — BSC, 137 — Polygon, 8453 — Base,
# 42161 — Arbitrum, 43114 — Avalanche. Пусто — все шесть основных.
EVM_CHAIN_IDS=

# Сервис управления: веб-панель на /admin (порт PORT) + лог-буфер.
# Пусто — панель отключена. Придумайте длинную случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PANEL_TOKEN=
